  <!-- Script interactivo -->
  <script>
    function setMode(mode) {
      const buttons = document.querySelectorAll('.mode-btn');
      buttons.forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      const valEh = document.getElementById('val-eh');
      const valPar = document.getElementById('val-par');
      const valEc = document.getElementById('val-ec');
      const valLsi = document.getElementById('val-lsi');
      const valVolt = document.getElementById('val-volt');
      const barEh = document.getElementById('bar-eh');
      const barPar = document.getElementById('bar-par');
      const tickerEh = document.getElementById('ticker-eh');

      if (mode === 'optimo') {
        valEh.innerHTML = '+384 <span>mV</span>';
        valPar.innerHTML = '9.4 <span>Bar</span>';
        valEc.innerText = '1.42 dS/m';
        valLsi.innerText = 'VIGOR PLENO (100%)';
        valVolt.innerText = '1.18 Vdc';
        barEh.style.width = '82%';
        barPar.style.width = '78%';
        tickerEh.innerText = '+384 mV';
      } else if (mode === 'lluvia') {
        valEh.innerHTML = '+210 <span>mV</span>';
        valPar.innerHTML = '11.8 <span>Bar</span>';
        valEc.innerText = '0.88 dS/m';
        valLsi.innerText = 'FLUJO HÍDRICO MÁXIMO (92%)';
        valVolt.innerText = '2.45 Vdc';
        barEh.style.width = '48%';
        barPar.style.width = '94%';
        tickerEh.innerText = '+210 mV';
      } else if (mode === 'estres') {
        valEh.innerHTML = '+465 <span>mV</span>';
        valPar.innerHTML = '6.2 <span>Bar</span>';
        valEc.innerText = '2.15 dS/m';
        valLsi.innerText = 'BARRERA SILÍCEA SELLADA (98%)';
        valVolt.innerText = '0.72 Vdc';
        barEh.style.width = '96%';
        barPar.style.width = '52%';
        tickerEh.innerText = '+465 mV';
      }
    }
  </script>
